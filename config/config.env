# All paths may be absolute or relative to the repository root.
INPUT_DIR="data/raw"
OUTPUT_DIR="results"
ADAPTER_FILE="config/adapters.fasta"

# Paired-end names: SAMPLE_1.fastq.gz and SAMPLE_2.fastq.gz
R1_SUFFIX="_1.fastq.gz"
R2_SUFFIX="_2.fastq.gz"

# Resources and assembly settings
THREADS="8"
SPADES_MEMORY_GB="16"
DEPTH_CUTOFF="150"
MIN_CONTIG_LENGTH="500"
MIN_CONTIG_COVERAGE="3"
SPADES_CAREFUL="false"
RUN_CUTADAPT="false"

# Optional. In the supplied container this database is already here.
CONFINDR_DB="/confindr_database"

